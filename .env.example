# ---------------------------------------------------------------------------
# Public site URL
# ---------------------------------------------------------------------------
# Optional on Netlify. When unset, the build derives the origin from the deploy
# context (`URL` in production, `DEPLOY_PRIME_URL` for previews), so production
# never falls back to localhost. Set it explicitly only to pin a custom domain
# that differs from the Netlify primary URL.
#
# Must match the "Site URL" configured under Identity in the Netlify UI —
# Identity builds confirmation, recovery and invite links from that setting.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Stripe server-side configuration (test mode)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ADVANCED=
STRIPE_PRICE_QUANT=

# ---------------------------------------------------------------------------
# Optional AI analyst provider key
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Sports data provider (API-FOOTBALL / API-SPORTS)
# ---------------------------------------------------------------------------
# SERVER SIDE ONLY. Never expose this as NEXT_PUBLIC_*, never send it to the
# browser, and never commit a real value. Set it in the Netlify UI under
# Site configuration → Environment variables.
#
# Leave it empty locally to run the app on the demo dataset: the sports layer
# reports "API not configured" instead of failing, and no provider request is
# ever attempted.
API_FOOTBALL_KEY=
